{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-nrlis.local/schemas/care-aac-synthetic-interactions-v1.schema.json",
  "title": "NRLIS Care-mode synthetic interaction scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suiteId",
    "dataClassification",
    "scenarioKind",
    "participantRecords",
    "persistence",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "suiteId": {"const": "CARE-SYNTH-INTERACTIONS-V1"},
    "dataClassification": {"const": "synthetic_no_participant_data"},
    "scenarioKind": {"const": "synthetic_state_transition"},
    "participantRecords": {"const": 0},
    "persistence": {"const": false},
    "scenarios": {
      "type": "array",
      "minItems": 7,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "steps"],
      "properties": {
        "id": {"type": "string", "pattern": "SYN-INT-[0-9]{3}"},
        "purpose": {
          "enum": [
            "direct_confirmation",
            "rejection_and_correction",
            "panel_navigation_and_compact_surface",
            "none_to_fallback",
            "repeat_is_non_output",
            "cancel_clears_state",
            "hidden_concept_rejected"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "expect"],
      "properties": {
        "action": {
          "enum": [
            "SELECT_CONTEXT",
            "NEXT_PANEL",
            "PREVIOUS_PANEL",
            "PROPOSE",
            "CONFIRM",
            "REJECT",
            "NONE",
            "REPEAT",
            "FALLBACK",
            "CANCEL",
            "SET_SURFACE"
          ]
        },
        "contextId": {
          "type": "string",
          "pattern": "[a-z][a-z0-9-]{2,39}"
        },
        "conceptId": {
          "type": "string",
          "pattern": "[a-z][a-z0-9-]{2,49}"
        },
        "surfaceMode": {"enum": ["canonical", "compact"]},
        "expect": {"$ref": "#/$defs/expectation"}
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "contextId": {
          "type": ["string", "null"],
          "pattern": "[a-z][a-z0-9-]{2,39}"
        },
        "panelId": {
          "type": ["string", "null"],
          "pattern": "[a-z][a-z0-9-]{2,49}"
        },
        "surfaceMode": {"enum": ["canonical", "compact"]},
        "pendingConceptId": {
          "type": ["string", "null"],
          "pattern": "[a-z][a-z0-9-]{2,49}"
        },
        "confirmedConceptId": {
          "type": ["string", "null"],
          "pattern": "[a-z][a-z0-9-]{2,49}"
        },
        "confirmed": {"type": "boolean"},
        "fallbackActive": {"type": "boolean"},
        "statusCode": {
          "enum": [
            "ready",
            "context_selected",
            "next_panel",
            "previous_panel",
            "candidate_pending",
            "message_confirmed",
            "candidate_rejected",
            "no_candidate_matches",
            "panel_repeated",
            "fallback_active",
            "cancelled",
            "surface_mode_changed",
            "concept_not_visible"
          ]
        }
      }
    }
  }
}
